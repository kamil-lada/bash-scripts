PIN_INTERFACES=
PIN_PREFIX=

NETWORK_TYPE=
STATIC_IP=
CIDR_PREFIX=
GATEWAY_IP=
DNS_SERVERS=

INSTALL_ZABBIX=
ZABBIX_ADDRESS=
ZABBIX_PORT=

INSTALL_GRAYLOG=
GRAYLOG_ADDRESS=
GRAYLOG_API_TOKEN=
# Comma separated, e.g. linux,web
GRAYLOG_TAGS=
GRAYLOG_TLS_SKIP_VERIFY=

CREATE_SWAP=
SWAP_SIZE_GB=

CLONE_REPO=
