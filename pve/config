# Phase 2: bash 2.initialize_for_usecase.sh [config]  (default: /etc/instance_config, else this file)
# Yes/no values: y/n (yes/no/true/false also accepted)

INSTANCE_HOSTNAME=
INSTANCE_DOMAIN=
INSTANCE_TIMEZONE=

